# APP_URL HANYA dipakai sebagai fallback untuk konteks CLI (cron job,
# script backup, worker) yang tidak punya $_SERVER['HTTP_HOST'].
# Untuk request web biasa, base URL dideteksi OTOMATIS dari request
# (lihat app/Helpers/functions.php) — TIDAK perlu diubah saat pindah
# dari Local ke Ngrok ke Hosting.
APP_NAME="UD. LAU Store"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_KEY=

# Saat deployment ke Hosting, ubah 2 baris ini:
#   APP_ENV=production
#   APP_DEBUG=false
# (timezone biasanya tidak perlu berubah)

# PENTING: nama variabel di bawah ini WAJIB persis seperti ini
# (DB_DATABASE, DB_USERNAME, DB_PASSWORD) — bukan DB_NAME/DB_USER/DB_PASS,
# karena config/database.php membaca nama-nama ini secara eksplisit.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lau_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=lau_store_session
SESSION_LIFETIME=7200

UPLOAD_MAX_SIZE=3145728
